# ============================================================
# VLA-Eval Environment Configuration Example
# Copy to `.env` and fill in real values. Never commit `.env`.
# ============================================================

# --- Application ---
APP_ENV=development                # development | staging | production
APP_NAME=vla-eval
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=change-me-to-a-long-random-string

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
API_RATE_LIMIT_PER_MINUTE=120
API_JWT_ALGORITHM=HS256
API_JWT_EXPIRE_MINUTES=60
API_KEY_HEADER_NAME=X-API-Key
API_DEFAULT_API_KEY=dev-local-api-key-change-me

# --- Database (job metadata, leaderboard) ---
DATABASE_URL=postgresql+psycopg2://vla_eval:vla_eval@postgres:5432/vla_eval
# For local dev without Docker: sqlite:///./vla_eval.db

# --- MLflow ---
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=vla-eval
MLFLOW_ARTIFACT_ROOT=/mlartifacts
MLFLOW_S3_ENDPOINT_URL=
MLFLOW_BACKEND_STORE_URI=postgresql+psycopg2://mlflow:mlflow@postgres:5432/mlflow

# --- Hugging Face ---
HF_TOKEN=
HF_HOME=/data/hf_cache
HF_HUB_ENABLE_HF_TRANSFER=1

# --- Object storage (optional, MinIO/S3 for datasets & artifacts) ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_DATASETS=vla-eval-datasets
S3_BUCKET_ARTIFACTS=vla-eval-artifacts

# --- Redis (job queue / caching) ---
REDIS_URL=redis://redis:6379/0

# --- Training defaults ---
TRAINING_DEVICE=cuda                # cuda | cpu | mps
TRAINING_MIXED_PRECISION=bf16
TRAINING_NUM_WORKERS=4

# --- Artifact output roots (API/worker jobs) ---
CHECKPOINT_ROOT=./models/checkpoints
REPORT_ROOT=./reports/generated

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
